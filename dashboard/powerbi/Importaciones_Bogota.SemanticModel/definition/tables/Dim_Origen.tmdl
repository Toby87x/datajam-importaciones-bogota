	partition Dim_Origen = m
		mode: import
		source = ```
				let
				    // Origen + región ONU M49 (fuente 3), integrados por código ISO alfa-3 en el notebook
				    Columnas = Table.SelectColumns(Importaciones_Base, {"Cod_Orig", "Pais_Origen", "Tipo_Origen", "ISO3", "Region", "Subregion"}),
				    Unicos = Table.Distinct(Columnas, {"Cod_Orig"}),
				    // "Otros" agrupa 10 códigos distintos: se etiqueta con su código para no fusionarlos
				    Etiqueta = Table.AddColumn(Unicos, "Origen", each if [Pais_Origen] = "Otros" then "Otros (cód. " & [Cod_Orig] & ")" else [Pais_Origen], type text)
				in
				    Etiqueta
			```

