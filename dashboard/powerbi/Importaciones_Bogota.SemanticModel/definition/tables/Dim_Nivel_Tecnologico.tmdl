	partition Dim_Nivel_Tecnologico = m
		mode: import
		source = ```
				let
				    Columnas = Table.SelectColumns(Importaciones_Base, {"Nivel_Tecnologico"}),
				    Unicos = Table.Distinct(Columnas),
				    Orden = {"Manufacturas de alta tecnología", "Manufacturas de tecnología media", "Manufacturas de baja tecnología",
				        "Manufacturas basadas en recursos naturales", "Bienes primarios", "Otras transacciones", "Sin clasificar"},
				    ConOrden = Table.AddColumn(Unicos, "Orden", each let p = List.PositionOf(Orden, [Nivel_Tecnologico]) in if p < 0 then 99 else p + 1, Int64.Type)
				in
				    ConOrden
			```

