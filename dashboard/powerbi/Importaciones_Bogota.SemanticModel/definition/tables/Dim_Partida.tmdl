		level Partida
			lineageTag: bab55596-58d6-4024-885f-e69ca7835d5a
			column: Partida_Corta

	partition Dim_Partida = m
		mode: import
		source = ```
				let
				    Columnas = Table.SelectColumns(Importaciones_Base, {"Cod_Partida", "Partida", "Cod_Capitulo", "Capitulo"}),
				    Unicos = Table.Distinct(Columnas, {"Cod_Partida"}),
				    // Nombre corto para ejes (los nombres originales llegan a 839 caracteres)
				    Corta = Table.AddColumn(Unicos, "Partida_Corta", each [Cod_Partida] & " · " & (if Text.Length([Partida]) > 45 then Text.Start([Partida], 45) & "…" else [Partida]), type text),
				    EtiquetaCap = Table.AddColumn(Corta, "Capitulo_Etiqueta", each [Cod_Capitulo] & " · " & [Capitulo], type text)
				in
				    EtiquetaCap
			```

